---
// src/components/Analytics.astro
// Pluggable privacy-friendly analytics (Umami, Plausible, Fathom)
// Disabled by default. Renders zero scripts when disabled.
import { siteConfig } from '../../site.config';

const { enabled, provider, websiteId, host, domain } = siteConfig.analytics;
const shouldRender = enabled && (provider === 'plausible' || Boolean(websiteId));
---

{shouldRender && provider === 'umami' && (
  <script
    async
    defer
    src={host ? `${host.replace(/\/$/, '')}/script.js` : 'https://cloud.umami.is/script.js'}
    data-website-id={websiteId}
  />
)}

{shouldRender && provider === 'plausible' && (
  <script
    defer
    data-domain={domain || `${siteConfig.githubUser.toLowerCase()}.github.io`}
    src={`${host ? host.replace(/\/$/, '') : 'https://plausible.io'}/js/script.js`}
  />
)}

{shouldRender && provider === 'fathom' && (
  <script
    src={host ? `${host.replace(/\/$/, '')}/script.js` : 'https://cdn.usefathom.com/script.js'}
    data-site={websiteId}
    defer
  />
)}
