---
// src/components/CodeBlockEnhancer.astro
// Adds language labels, copy buttons with visual feedback, and responsive horizontal scroll
---

<style is:global>
  .code-block-container {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin: 1.75rem 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background-color: var(--code-bg);
    overflow: hidden;
  }

  .code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.85rem;
    background-color: var(--surface);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--text-muted);
    user-select: none;
  }

  .code-lang-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .code-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-code);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .code-copy-btn:hover {
    color: var(--accent);
    background-color: var(--bg);
    border-color: var(--border);
  }

  .code-copy-btn.copied {
    color: var(--callout-tip-border);
    background-color: var(--callout-tip-bg);
    border-color: var(--callout-tip-border);
  }

  @media (hover: none) {
    .code-copy-btn {
      min-height: 38px;
      padding: 0.35rem 0.65rem;
      border-color: var(--border);
      background-color: var(--bg);
    }
  }

  .code-block-container pre.astro-code {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin: 0 !important;
    padding: 1rem 1.15rem !important;
    border: none !important;
    border-radius: 0 !important;
    overflow-x: auto !important;
    white-space: pre !important;
    word-break: normal !important;
    font-family: var(--font-code);
    font-size: 0.9rem;
    line-height: 1.6;
    background-color: var(--code-bg) !important;
    color: var(--text) !important;
  }

  .code-block-container pre.astro-code code {
    background-color: transparent !important;
    color: inherit !important;
    font-family: inherit;
    font-size: inherit;
  }
</style>

<script>
  const COPY_ICON = `
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span class="copy-text">Copy</span>
  `;

  const COPIED_ICON = `
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span class="copy-text">Copied!</span>
  `;

  function setupCodeCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.code-block-container .code-copy-btn').forEach((copyBtn) => {
      if (copyBtn.dataset.bound === 'true') return;
      copyBtn.dataset.bound = 'true';

      copyBtn.addEventListener('click', async () => {
        const container = copyBtn.closest('.code-block-container');
        const pre = container?.querySelector<HTMLPreElement>('pre');
        if (!pre) return;
        const codeElement = pre.querySelector('code');
        const textToCopy = codeElement ? codeElement.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = COPIED_ICON;

          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = COPY_ICON;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code: ', err);
        }
      });
    });
  }

  setupCodeCopyButtons();
</script>
