---
// src/components/Comments.astro
// Lazy-loaded Giscus comments integration per Section 11
import { siteConfig, getSiteOrigin, getPath } from '../../site.config';

export interface Props {
  articleCommentsEnabled?: boolean;
}

const { articleCommentsEnabled = true } = Astro.props;

const {
  enabled,
  repo,
  repoId,
  category,
  categoryId,
  mapping = 'pathname',
  reactionsEnabled = true,
  emitMetadata = false,
} = siteConfig.comments;

// Section 11: Disabled or empty IDs render nothing and never fail the build
const isConfigured = enabled && Boolean(repoId) && Boolean(categoryId);
const shouldRender = isConfigured && articleCommentsEnabled;

const siteOrigin = getSiteOrigin();
const latteThemeUrl = `${siteOrigin}${getPath('/giscus-latte.css')}`;
const espressoThemeUrl = `${siteOrigin}${getPath('/giscus-espresso.css')}`;
---

{shouldRender && (
  <section id="comments" class="comments-section" aria-label="Article Comments">
    <div class="comments-header">
      <h2 class="comments-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="comments-icon">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Comments
      </h2>
      <p class="comments-description">
        Discussions are hosted on GitHub Discussions. Sign in with GitHub to participate.
      </p>
    </div>

    <div
      id="giscus-container"
      class="giscus-container"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping={mapping}
      data-reactions-enabled={reactionsEnabled ? '1' : '0'}
      data-emit-metadata={emitMetadata ? '1' : '0'}
      data-theme-latte={latteThemeUrl}
      data-theme-espresso={espressoThemeUrl}
    >
      <div id="comments-loading" class="comments-loading">
        <span class="loading-spinner" aria-hidden="true"></span>
        <span>Loading discussion...</span>
      </div>
    </div>
  </section>

  <script>
    function setupGiscus() {
      const container = document.getElementById('giscus-container');
      if (!container) return;

      const loadingEl = document.getElementById('comments-loading');

      const repo = container.dataset.repo;
      const repoId = container.dataset.repoId;
      const category = container.dataset.category;
      const categoryId = container.dataset.categoryId;
      const mapping = container.dataset.mapping || 'pathname';
      const reactions = container.dataset.reactionsEnabled || '1';
      const emitMetadata = container.dataset.emitMetadata || '0';
      const latteTheme = container.dataset.themeLatte || 'light';
      const espressoTheme = container.dataset.themeEspresso || 'dark_dimmed';

      function getCurrentTheme(): string {
        const isLocalhost = Boolean(
          window.location.hostname === 'localhost' ||
          window.location.hostname === '127.0.0.1' ||
          window.location.hostname.endsWith('.local')
        );

        const themeAttr = document.documentElement.getAttribute('data-theme');
        const isDark =
          themeAttr === 'espresso' ||
          (!themeAttr && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);

        // On localhost before remote deployment, use Giscus built-in themes to prevent 404 wireframe borders
        if (isLocalhost) {
          return isDark ? 'dark_dimmed' : 'light';
        }

        return isDark ? espressoTheme : latteTheme;
      }

      let scriptLoaded = false;

      // Listen for Giscus resizeHeight message so the spinner only hides when the iframe is truly sized
      function onGiscusMessage(e: MessageEvent) {
        if (e.origin !== 'https://giscus.app') return;
        const h = e.data?.giscus?.resizeHeight;
        if (typeof h === 'number' && h > 0) {
          if (loadingEl) loadingEl.style.display = 'none';
          if (container) container.style.minHeight = '0';
        }
      }
      window.addEventListener('message', onGiscusMessage);

      function loadGiscusScript() {
        if (scriptLoaded || !container) return;
        scriptLoaded = true;

        const preconnect = document.createElement('link');
        preconnect.rel = 'preconnect';
        preconnect.href = 'https://giscus.app';
        preconnect.crossOrigin = 'anonymous';
        document.head.appendChild(preconnect);

        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.async = true;
        script.crossOrigin = 'anonymous';

        script.setAttribute('data-repo', repo || '');
        script.setAttribute('data-repo-id', repoId || '');
        script.setAttribute('data-category', category || '');
        script.setAttribute('data-category-id', categoryId || '');
        script.setAttribute('data-mapping', mapping);
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', reactions);
        script.setAttribute('data-emit-metadata', emitMetadata);
        script.setAttribute('data-input-position', 'top');
        script.setAttribute('data-theme', getCurrentTheme());
        script.setAttribute('data-lang', 'en');
        // Do NOT set data-loading="lazy": IntersectionObserver already lazy-loads the script,
        // and double lazy-loading leaves the iframe stuck at 150px default height on mobile.

        script.onload = () => {
          // Fallback: if resizeHeight postMessage hasn't arrived after 2.5s, hide loading indicator
          setTimeout(() => {
            if (loadingEl) loadingEl.style.display = 'none';
          }, 2500);
        };

        container.appendChild(script);
      }

      // Section 11: Lazy-load with IntersectionObserver
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                observer.disconnect();
                loadGiscusScript();
              }
            });
          },
          { rootMargin: '400px 0px' }
        );

        observer.observe(container);
      } else {
        // Fallback for browsers without IntersectionObserver
        loadGiscusScript();
      }

      // Section 11: Sync Giscus theme with site toggle via postMessage
      window.addEventListener('theme-change', (e: Event) => {
        const customEvent = e as CustomEvent<{ theme: string }>;
        const newThemeName = customEvent.detail?.theme;
        const isDark = newThemeName === 'espresso';
        const isLocalhost = Boolean(
          window.location.hostname === 'localhost' ||
          window.location.hostname === '127.0.0.1' ||
          window.location.hostname.endsWith('.local')
        );

        const targetTheme = isLocalhost
          ? isDark
            ? 'dark_dimmed'
            : 'light'
          : isDark
            ? espressoTheme
            : latteTheme;

        const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: targetTheme } } },
            'https://giscus.app'
          );
        }
      });
    }

    setupGiscus();
    document.addEventListener('astro:after-swap', setupGiscus);
  </script>
)}

<style>
  .comments-section {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    overflow: visible;
  }

  .comments-header {
    margin-bottom: 2rem;
  }

  .comments-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 0.4rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .comments-icon {
    color: var(--accent);
  }

  .comments-description {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .giscus-container {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 260px;
    position: relative;
    overflow: visible;
  }

  .giscus-container :global(.giscus),
  .giscus-container :global(.giscus-frame) {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    display: block !important;
    border: none !important;
  }

  .comments-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem;
    color: var(--text-muted);
    font-family: var(--font-code);
    font-size: 0.9rem;
  }

  .loading-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
