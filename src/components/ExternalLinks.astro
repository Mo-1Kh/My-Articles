---
// src/components/ExternalLinks.astro
// Automatically applies target="_blank", rel="noopener noreferrer", and external icon to outbound links
---

<style is:global>
  .external-link-icon {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.25rem;
    width: 0.85em;
    height: 0.85em;
    opacity: 0.7;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  a:hover .external-link-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }
</style>
