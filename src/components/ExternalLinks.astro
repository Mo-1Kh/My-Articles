---
// src/components/ExternalLinks.astro
// Automatically applies target="_blank", rel="noopener noreferrer", and external icon to outbound links
---

<style is:global>
  .external-link-icon {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.25rem;
    width: 0.85em;
    height: 0.85em;
    opacity: 0.7;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  a:hover .external-link-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }
</style>

<script>
  function setupExternalLinks() {
    const articleLinks = document.querySelectorAll<HTMLAnchorElement>('.article-body a[href]');
    const currentHost = window.location.host;

    articleLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;

      // Ignore anchor links, mailto, tel, javascript
      if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
        return;
      }

      // Check if external
      try {
        const url = new URL(href, window.location.origin);
        if (url.host !== currentHost) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');

          // Append external link icon if not already present
          if (!link.querySelector('.external-link-icon')) {
            const iconSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            iconSvg.setAttribute('class', 'external-link-icon');
            iconSvg.setAttribute('viewBox', '0 0 24 24');
            iconSvg.setAttribute('fill', 'none');
            iconSvg.setAttribute('stroke', 'currentColor');
            iconSvg.setAttribute('stroke-width', '2');
            iconSvg.setAttribute('stroke-linecap', 'round');
            iconSvg.setAttribute('stroke-linejoin', 'round');
            iconSvg.setAttribute('aria-hidden', 'true');
            iconSvg.innerHTML = '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>';

            const srSpan = document.createElement('span');
            srSpan.className = 'sr-only';
            srSpan.textContent = ' (opens in a new tab)';

            link.appendChild(iconSvg);
            link.appendChild(srSpan);
          }
        }
      } catch {
        // Relative or invalid URLs stay internal
      }
    });
  }

  setupExternalLinks();
  document.addEventListener('astro:after-swap', setupExternalLinks);
</script>
