---
// src/components/HeadingAnchors.astro
// Adds subtle hover/focus anchor links to all h2 and h3 headings in articles
---

<style is:global>
  .article-body h2,
  .article-body h3 {
    position: relative;
    scroll-margin-top: 5rem;
  }

  .heading-anchor {
    display: inline-block;
    margin-left: 0.45rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: normal;
    font-size: 0.85em;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
    user-select: none;
    padding: 0 0.25rem;
    border-radius: 3px;
  }

  .article-body h2:hover .heading-anchor,
  .article-body h3:hover .heading-anchor,
  .heading-anchor:focus-visible {
    opacity: 1;
    color: var(--accent);
  }

  .heading-anchor:hover {
    color: var(--link-hover);
    transform: scale(1.1);
  }

  @media (hover: none) {
    .heading-anchor {
      opacity: 0.55;
      padding: 0.25rem 0.4rem;
    }
  }
</style>

<script>
  function setupHeadingAnchors() {
    document.querySelectorAll<HTMLAnchorElement>('.article-body .heading-anchor').forEach((anchor) => {
      if (anchor.dataset.bound === 'true') return;
      anchor.dataset.bound = 'true';

      anchor.addEventListener('click', async () => {
        const href = anchor.getAttribute('href') || '';
        const url = `${window.location.origin}${window.location.pathname}${href}`;
        try {
          await navigator.clipboard.writeText(url);
          const span = anchor.querySelector('span');
          if (span) {
            span.textContent = '✓';
            setTimeout(() => {
              span.textContent = '#';
            }, 1500);
          }
        } catch {
          // If clipboard fails, regular browser navigation proceeds
        }
      });
    });
  }

  setupHeadingAnchors();
</script>
