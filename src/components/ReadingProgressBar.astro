---
// src/components/ReadingProgressBar.astro
// Subtle reading progress indicator fixed at top of viewport per Section 10.
// Uses native CSS scroll-driven animations on the compositor with a JS fallback.
---

<div
  id="reading-progress"
  class="reading-progress-bar"
  role="progressbar"
  aria-label="Article reading progress"
  aria-valuenow="0"
  aria-valuemin="0"
  aria-valuemax="100"
></div>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent);
    z-index: 1000;
    pointer-events: none;
    transition: width 0.1s linear;
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress-bar {
      width: 100%;
      transform-origin: 0 50%;
      transform: scaleX(0);
      transition: none;
      animation: reading-progress-grow linear both;
      animation-timeline: scroll(root);
    }

    @keyframes reading-progress-grow {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
</style>

<script>
  function setupReadingProgress() {
    if (CSS.supports && CSS.supports('animation-timeline: scroll()')) {
      return;
    }

    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.article-body');

    if (!progressBar || !article) return;

    let ticking = false;

    function update() {
      if (!progressBar || !article) return;
      const rect = article.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const articleHeight = rect.height;
      const startOffset = rect.top;

      const scrolled = -startOffset;
      const totalScrollable = articleHeight - viewportHeight * 0.6;

      let progress = 0;
      if (totalScrollable > 0) {
        progress = Math.min(100, Math.max(0, (scrolled / totalScrollable) * 100));
      }

      progressBar.style.width = `${progress}%`;
      progressBar.setAttribute('aria-valuenow', Math.round(progress).toString());
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  setupReadingProgress();
</script>
