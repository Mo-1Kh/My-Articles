---
// src/components/TableOfContents.astro
// Sticky desktop sidebar & collapsible mobile drawer with IntersectionObserver tracking
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: HeadingItem[];
  mode?: 'both' | 'mobile' | 'desktop';
}

const { headings, mode = 'both' } = Astro.props;
const showMobile = mode === 'both' || mode === 'mobile';
const showDesktop = mode === 'both' || mode === 'desktop';
---

{showMobile && (
  <details class="toc-mobile" aria-label="Table of contents">
    <summary class="toc-mobile-summary">
      <span class="toc-header-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        Table of Contents
      </span>
      <svg class="toc-mobile-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <nav class="toc-nav" aria-label="Mobile table of contents">
      <ul class="toc-list">
        {headings.map((h) => (
          <li class={`toc-item depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

{showDesktop && (
  <aside class="toc-desktop" aria-label="Table of contents">
    <div class="toc-desktop-sticky">
      <nav class="toc-nav" aria-label="Desktop table of contents">
        <h2 class="toc-desktop-title">On this page</h2>
        <ul class="toc-list">
          {headings.map((h) => (
            <li class={`toc-item depth-${h.depth}`}>
              <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </aside>
)}

<style>
  /* Common TOC Item Styles */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .toc-link {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.4;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--accent);
    background-color: var(--surface);
  }

  .toc-link.active {
    color: var(--accent);
    font-weight: 600;
    border-left-color: var(--accent);
    background-color: var(--surface);
  }

  /* Mobile Collapsible TOC */
  .toc-mobile {
    display: block;
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .toc-mobile-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    list-style: none;
    user-select: none;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-mobile-chevron {
    transition: transform 0.2s ease;
  }

  .toc-mobile[open] .toc-mobile-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile .toc-nav {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-muted);
  }

  /* Desktop Sticky Sidebar */
  .toc-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
      width: 240px;
      flex-shrink: 0;
    }

    .toc-desktop-sticky {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      padding-left: 1.5rem;
      border-left: 1px solid var(--border-muted);
    }

    .toc-desktop-title {
      font-family: var(--font-heading);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin: 0 0 0.85rem 0.5rem;
      font-weight: 600;
    }
  }
</style>

<script>
  function setupToc() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    // Smooth scroll on link click
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-slug');
        if (!targetId) return;

        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          targetEl.scrollIntoView({
            behavior: prefersReduced ? 'auto' : 'smooth',
            block: 'start',
          });
          history.pushState(null, '', `#${targetId}`);
        }
      });
    });

    // IntersectionObserver to highlight active heading
    const headingElements = Array.from(tocLinks)
      .map((l) => document.getElementById(l.getAttribute('data-slug') || ''))
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length === 0) return;

    let activeSlug = '';

    const observer = new IntersectionObserver(
      (entries) => {
        // Find visible heading closest to top
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activeSlug = entry.target.id;
            break;
          }
        }

        if (activeSlug) {
          tocLinks.forEach((link) => {
            if (link.getAttribute('data-slug') === activeSlug) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      },
      {
        rootMargin: '-80px 0% -65% 0%',
        threshold: 0,
      }
    );

    headingElements.forEach((h) => observer.observe(h));
  }

  setupToc();
  document.addEventListener('astro:after-swap', setupToc);
</script>
