---
// ThemeToggle.astro
// Accessible theme toggle for Latte (light) and Espresso (dark)
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle between Latte (light) and Espresso (dark) theme"
  title="Toggle theme (Latte / Espresso)"
  class="theme-toggle-btn"
>
  <span class="sr-only">Toggle theme</span>
  <!-- Coffee Cup / Latte Icon (shown in dark theme) -->
  <svg class="icon icon-latte" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
    <line x1="6" y1="1" x2="6" y2="4"></line>
    <line x1="10" y1="1" x2="10" y2="4"></line>
    <line x1="14" y1="1" x2="14" y2="4"></line>
  </svg>
  <!-- Espresso Bean / Crescent Icon (shown in light theme) -->
  <svg class="icon icon-espresso" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }

  .theme-toggle-btn:hover {
    background-color: var(--surface);
    border-color: var(--accent);
  }

  .theme-toggle-btn:active {
    transform: scale(0.96);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Default light: show moon/espresso icon to switch to dark */
  .icon-latte {
    display: none;
  }
  .icon-espresso {
    display: block;
  }

  /* Dark mode: show coffee/latte icon to switch to light */
  :global([data-theme="espresso"]) .icon-latte {
    display: block;
  }
  :global([data-theme="espresso"]) .icon-espresso {
    display: none;
  }
</style>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'espresso' : 'latte');
      const next = current === 'espresso' ? 'latte' : 'espresso';

      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);

      // Notify any listeners (e.g. Giscus comments iframe in Phase 9)
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: next } }));
    });
  }

  // Setup on initial load and handle Astro page transitions if applicable
  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
