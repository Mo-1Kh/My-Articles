---
// src/pages/404.astro
// Artisanal coffee-themed 404 error page per Section 10
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../../site.config';

const homeUrl = getPath('/');
---

<BaseLayout title="404: Page Not Found" description="The page you requested could not be found." noIndex={true}>
  <div class="container not-found-container">
    <div class="not-found-card">
      <!-- Coffee Cup Graphic -->
      <div class="coffee-illustration" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="cup-svg">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <line x1="6" y1="2" x2="6" y2="4"></line>
          <line x1="10" y1="2" x2="10" y2="4"></line>
          <line x1="14" y1="2" x2="14" y2="4"></line>
          <line x1="2" y1="21" x2="22" y2="21"></line>
        </svg>
      </div>

      <div class="status-code">404</div>
      <h1 class="not-found-title">Brew Not Found</h1>
      <p class="not-found-message">
        It looks like this cup is empty. The article or resource you are looking for might have been moved, renamed, or never brewed in the first place.
      </p>

      <div class="action-buttons">
        <a href={homeUrl} class="btn-primary">
          &larr; Return to All Articles
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: 3rem 1.25rem;
  }

  .not-found-card {
    text-align: center;
    max-width: 520px;
    padding: 3rem 2rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .coffee-illustration {
    margin-bottom: 1rem;
    color: var(--accent);
    display: inline-block;
  }

  .cup-svg {
    animation: gentle-steam 3s ease-in-out infinite;
  }

  @keyframes gentle-steam {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .status-code {
    font-family: var(--font-code);
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .not-found-title {
    font-size: 2.25rem;
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .not-found-message {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--accent);
    color: var(--bg);
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background-color: var(--link-hover);
    transform: translateY(-1px);
    text-decoration: none;
  }
</style>
