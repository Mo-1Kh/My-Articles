---
// [category]/[slug].astro - Full Article Page with Obsidian rendering per Section 9
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGroupedCategories, type Article } from '../../lib/articles';
import { render } from 'astro:content';
import { getPath, getCanonicalUrl } from '../../../site.config';
import { calculateReadingTime, countWords } from '../../lib/reading-time';
import { generateExcerpt } from '../../lib/excerpt';
import ImageLightbox from '../../components/ImageLightbox.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CodeBlockEnhancer from '../../components/CodeBlockEnhancer.astro';
import HeadingAnchors from '../../components/HeadingAnchors.astro';
import BackToTop from '../../components/BackToTop.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const categories = await getGroupedCategories();
  const paths = [];

  for (const cat of categories) {
    // cat.articles are already sorted oldest to newest per Section 7
    for (let i = 0; i < cat.articles.length; i++) {
      const article = cat.articles[i];
      const prev = i > 0 ? cat.articles[i - 1] : null;
      const next = i < cat.articles.length - 1 ? cat.articles[i + 1] : null;

      paths.push({
        params: {
          category: article.categorySlug,
          slug: article.slug,
        },
        props: {
          article,
          prevArticle: prev ? { title: prev.title, url: prev.url } : null,
          nextArticle: next ? { title: next.title, url: next.url } : null,
        },
      });
    }
  }

  return paths;
}

interface Props {
  article: Article;
  prevArticle: { title: string; url: string } | null;
  nextArticle: { title: string; url: string } | null;
}

const { article, prevArticle, nextArticle } = Astro.props;
const { Content, headings } = await render(article.entry);

const readingTime = calculateReadingTime(article.rawBody);
const wordCount = countWords(article.rawBody);
const tocHeadings = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label' && h.text.toLowerCase() !== 'footnotes'
);
// Section 10: Hidden on short articles (fewer than 3 headings or fewer than 400 words)
const showToc = tocHeadings.length >= 3 && wordCount >= 400;

// Section 10: Fall back to auto-excerpt (~155 chars) if description not in frontmatter
const metaDescription = article.description && article.description.trim() !== ''
  ? article.description
  : generateExcerpt(article.rawBody);

const canonicalUrl = getCanonicalUrl(`/${article.categorySlug}/${article.slug}/`);
const ogImageUrl = article.cover || `/og/${article.categorySlug}/${article.slug}.png`;

// Detect if math or mermaid diagrams are present to conditionally load dependencies
const hasMath = /\$|\\\(|\\\[/.test(article.rawBody);
const hasMermaid = /```mermaid\b/.test(article.rawBody);

const katexCssUrl = getPath('/vendor/katex/katex.min.css');
const mermaidJsUrl = getPath('/vendor/mermaid/mermaid.esm.min.mjs');
const homeUrl = getPath('/');

function formatDate(date: Date): string {
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
  const d = String(date.getUTCDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout
  title={article.title}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={ogImageUrl}
  publishedTime={article.publishedDate}
  modifiedTime={article.modifiedDate}
  category={article.category}
  tags={article.tags}
>
  <ReadingProgressBar />
  {hasMath && <link rel="stylesheet" href={katexCssUrl} />}

  <article class:list={['container', 'article-page', { 'has-toc': showToc }]}>
    {(article.draft || article.isScheduled) && (
      <aside class="preview-banner" role="status">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>
          <strong>Preview Mode:</strong> {article.draft ? 'This article has draft: true and is only visible in preview mode.' : `Scheduled post (releases on ${formatDate(article.publishedDate)}).`}
        </span>
      </aside>
    )}

    <header class="article-header">
      <div class="article-meta">
        <span class="meta-category">{article.category}</span>
        <span class="meta-sep">&bull;</span>
        <time datetime={article.publishedDate.toISOString()} class="meta-date">
          {formatDate(article.publishedDate)}
        </time>
        {article.modifiedDate && (
          <>
            <span class="meta-sep">&bull;</span>
            <span class="meta-modified">
              Modified <time datetime={article.modifiedDate.toISOString()}>{formatDate(article.modifiedDate)}</time>
            </span>
          </>
        )}
        <span class="meta-sep">&bull;</span>
        <span class="meta-reading-time">{readingTime}</span>
      </div>

      <h1 class="article-title">{article.title}</h1>
    </header>

    <div class:list={['article-layout', { 'has-toc': showToc }]}>
      <div class="article-main">
        {showToc && <TableOfContents headings={tocHeadings} mode="mobile" />}
        <div class="article-body">
          <Content />
        </div>
      </div>

      {showToc && <TableOfContents headings={tocHeadings} mode="desktop" />}
    </div>

    <footer class="article-footer">
      <!-- Previous / Next Navigation within Category -->
      {(prevArticle || nextArticle) && (
        <nav class="article-pagination" aria-label="Article navigation within category">
          {prevArticle ? (
            <a href={prevArticle.url} class="pagination-link prev" rel="prev">
              <span class="pagination-sub">&larr; Previous</span>
              <span class="pagination-title">{prevArticle.title}</span>
            </a>
          ) : (
            <div class="pagination-empty" />
          )}

          {nextArticle ? (
            <a href={nextArticle.url} class="pagination-link next" rel="next">
              <span class="pagination-sub">Next &rarr;</span>
              <span class="pagination-title">{nextArticle.title}</span>
            </a>
          ) : (
            <div class="pagination-empty" />
          )}
        </nav>
      )}

      <div class="home-return">
        <a href={homeUrl} class="back-home-link">&larr; Back to all articles</a>
      </div>

      <!-- Section 11: Comments (Giscus) -->
      <Comments articleCommentsEnabled={article.comments !== false} />
    </footer>
  </article>

  {hasMermaid && (
    <script type="module" define:vars={{ mermaidJsUrl }}>
      import mermaid from mermaidJsUrl;
      function initMermaid() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'espresso';
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'neutral',
          fontFamily: 'inherit',
        });
        mermaid.run({ querySelector: 'pre.mermaid' });
      }
      initMermaid();
      window.addEventListener('theme-change', initMermaid);
    </script>
  )}

  <CodeBlockEnhancer />
  <HeadingAnchors />
  <BackToTop />
  <ExternalLinks />
  <ImageLightbox />
</BaseLayout>

<style>
  .article-page {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
    transition: max-width 0.2s ease;
  }

  .preview-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-md);
    background-color: var(--callout-warning-bg);
    border: 1px solid var(--callout-warning-border);
    color: var(--callout-warning-border);
    font-size: 0.9rem;
    font-family: var(--font-body);
  }

  .preview-banner svg {
    flex-shrink: 0;
  }

  /* Desktop two-column layout when TOC is present */
  @media (min-width: 1024px) {
    .article-page.has-toc {
      max-width: 1040px;
    }

    .article-layout.has-toc {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 3rem;
    }

    .article-layout.has-toc .article-main {
      flex: 1;
      min-width: 0;
      max-width: 720px;
    }
  }

  .article-layout {
    display: block;
    position: relative;
  }

  .article-header {
    margin-bottom: 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-muted);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .meta-category {
    color: var(--accent);
    font-weight: 600;
  }

  .meta-sep {
    color: var(--border);
    opacity: 0.8;
  }

  .article-title {
    margin: 0;
    font-size: 2.35rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .article-body {
    line-height: var(--line-height-base, 1.75);
    font-size: 1.05rem;
  }

  /* Obsidian Wikilinks */
  .article-body :global(.wikilink) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }

  .article-body :global(.wikilink:hover) {
    color: var(--link-hover);
  }

  .article-body :global(.wikilink-broken) {
    color: var(--text-muted);
    border-bottom: 1px dashed var(--border);
    cursor: help;
  }

  /* Obsidian Tags */
  .article-body :global(.tag) {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.1em 0.5em;
    border-radius: 4px;
    margin: 0 0.2em;
    vertical-align: baseline;
  }

  /* Callouts styling & foldable chevrons */
  .article-body :global(.callout) {
    margin: 1.75em 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--border);
    background-color: var(--surface);
    border-radius: 4px;
  }

  .article-body :global(details.callout) {
    padding: 0;
  }

  .article-body :global(details.callout summary.callout-title) {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    user-select: none;
  }

  .article-body :global(details.callout summary.callout-title::-webkit-details-marker) {
    display: none;
  }

  .article-body :global(details.callout .callout-content) {
    padding: 0 1.25rem 1rem 1.25rem;
  }

  .article-body :global(.callout-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .article-body :global(.callout-fold-indicator) {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .article-body :global(details.callout[open] .callout-fold-indicator) {
    transform: rotate(180deg);
  }

  /* Callout themes */
  .article-body :global(.callout[data-callout="note"]),
  .article-body :global(.callout[data-callout="info"]) {
    border-left-color: var(--callout-note-border);
    background-color: var(--callout-note-bg);
  }
  .article-body :global(.callout[data-callout="note"] .callout-title),
  .article-body :global(.callout[data-callout="info"] .callout-title) {
    color: var(--callout-note-border);
  }

  .article-body :global(.callout[data-callout="tip"]),
  .article-body :global(.callout[data-callout="hint"]) {
    border-left-color: var(--callout-tip-border);
    background-color: var(--callout-tip-bg);
  }
  .article-body :global(.callout[data-callout="tip"] .callout-title),
  .article-body :global(.callout[data-callout="hint"] .callout-title) {
    color: var(--callout-tip-border);
  }

  .article-body :global(.callout[data-callout="warning"]),
  .article-body :global(.callout[data-callout="caution"]) {
    border-left-color: var(--callout-warning-border);
    background-color: var(--callout-warning-bg);
  }
  .article-body :global(.callout[data-callout="warning"] .callout-title),
  .article-body :global(.callout[data-callout="caution"] .callout-title) {
    color: var(--callout-warning-border);
  }

  .article-body :global(.callout[data-callout="danger"]),
  .article-body :global(.callout[data-callout="error"]) {
    border-left-color: var(--callout-danger-border);
    background-color: var(--callout-danger-bg);
  }
  .article-body :global(.callout[data-callout="danger"] .callout-title),
  .article-body :global(.callout[data-callout="error"] .callout-title) {
    color: var(--callout-danger-border);
  }

  /* Task lists */
  .article-body :global(ul.contains-task-list),
  .article-body :global(ul:has(input[type="checkbox"])) {
    list-style: none;
    padding-left: 0.5rem;
  }

  .article-body :global(li.task-list-item),
  .article-body :global(li:has(input[type="checkbox"])) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .article-body :global(input[type="checkbox"]) {
    accent-color: var(--accent);
    cursor: default;
  }

  /* Footnotes */
  .article-body :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-muted);
    font-size: 0.9em;
    color: var(--text-muted);
  }

  /* Mermaid Diagram */
  .article-body :global(pre.mermaid) {
    background: transparent;
    border: none;
    display: flex;
    justify-content: center;
    padding: 1.5rem 0;
  }

  /* Article Footer & Pagination */
  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-muted);
  }

  .article-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  .pagination-link:hover {
    border-color: var(--accent);
    background-color: var(--bg);
    transform: translateY(-1px);
  }

  .pagination-link.next {
    text-align: right;
  }

  .pagination-sub {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .pagination-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .pagination-empty {
    visibility: hidden;
  }

  .home-return {
    text-align: center;
    margin-bottom: 2rem;
  }

  .back-home-link {
    color: var(--link);
    text-decoration: none;
    font-weight: 500;
  }

  .back-home-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .article-pagination {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pagination-link.next {
      text-align: left;
    }
  }
</style>
