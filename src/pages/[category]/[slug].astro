---
// [category]/[slug].astro - Full Article Page with Obsidian rendering per Section 9
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGroupedCategories, slugify, type Article } from '../../lib/articles';
import { render } from 'astro:content';
import { getPath, getCanonicalUrl } from '../../../site.config';
import { getReadingStats } from '../../lib/reading-time';
import { generateExcerpt } from '../../lib/excerpt';
import { resolveImage } from '../../lib/images';
import ImageLightbox from '../../components/ImageLightbox.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import CodeBlockEnhancer from '../../components/CodeBlockEnhancer.astro';
import HeadingAnchors from '../../components/HeadingAnchors.astro';
import BackToTop from '../../components/BackToTop.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const categories = await getGroupedCategories();
  const paths = [];

  for (const cat of categories) {
    // cat.articles are already sorted oldest to newest per Section 7
    for (let i = 0; i < cat.articles.length; i++) {
      const article = cat.articles[i];
      const prev = i > 0 ? cat.articles[i - 1] : null;
      const next = i < cat.articles.length - 1 ? cat.articles[i + 1] : null;

      paths.push({
        params: {
          category: article.categorySlug,
          slug: article.slug,
        },
        props: {
          article,
          prevArticle: prev ? { title: prev.title, url: prev.url } : null,
          nextArticle: next ? { title: next.title, url: next.url } : null,
        },
      });
    }
  }

  return paths;
}

interface Props {
  article: Article;
  prevArticle: { title: string; url: string } | null;
  nextArticle: { title: string; url: string } | null;
}

const { article, prevArticle, nextArticle } = Astro.props;
const { Content } = await render(article.entry);

const readingStats = getReadingStats(article.rawBody);
const readingTime = readingStats.text;

// Section 10: Fall back to auto-excerpt (~155 chars) if description not in frontmatter
const metaDescription =
  article.description && article.description.trim() !== ''
    ? article.description
    : generateExcerpt(article.rawBody);

const canonicalUrl = getCanonicalUrl(`/${article.categorySlug}/${article.slug}/`);

// Resolve cover image through manifest (1200x630 PNG OG cover) or fall back to generated OG endpoint
let ogImageUrl = `/og/${article.categorySlug}/${article.slug}.png`;
let preloadCoverInfo: ReturnType<typeof resolveImage> = null;
if (article.cover) {
  if (article.cover.startsWith('http://') || article.cover.startsWith('https://')) {
    ogImageUrl = article.cover;
  } else {
    const resolvedCover = resolveImage(article.cover, article.id);
    if (resolvedCover) {
      ogImageUrl = resolvedCover.ogUrl || resolvedCover.optimizedUrl;
      preloadCoverInfo = resolvedCover;
    } else {
      ogImageUrl = article.cover;
    }
  }
}

// Accurate math detection: display math $$...$$, \(...\), \[...\], or inline $...$ (avoids prices/shell vars)
const cleanBodyForMath = article.rawBody.replace(/```[\s\S]*?```/g, '').replace(/`[^`]*`/g, '');
const hasMath = /\$\$[\s\S]+?\$\$|\\\(.*?\\\)|\\\[[\s\S]+?\\\]|(?<![\\\w])\$[^\s$][^$\n]*?\$(?!\d)/.test(
  cleanBodyForMath
);
const hasMermaid = /```mermaid\b/.test(article.rawBody);

const katexCssUrl = getPath('/vendor/katex/katex.min.css');
const homeUrl = getPath('/');
const categoryUrl = getPath(`/${article.categorySlug}/`);

function formatDate(date: Date): string {
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
  const d = String(date.getUTCDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout
  title={article.title}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={ogImageUrl}
  publishedTime={article.publishedDate}
  modifiedTime={article.modifiedDate}
  category={article.category}
  tags={article.tags}
  lang={article.lang}
  dir={article.dir}
  wordCount={readingStats.wordCount}
  readingMinutes={readingStats.minutes}
>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href={katexCssUrl} />}
    {preloadCoverInfo && preloadCoverInfo.variants?.avif?.length && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={preloadCoverInfo.variants.avif.map((v) => `${v.src} ${v.w}w`).join(', ')}
        imagesizes="(min-width: 760px) 720px, calc(100vw - 2rem)"
      />
    )}
  </Fragment>

  <ReadingProgressBar />

  <article class="container article-page">
    {(article.draft || article.isScheduled) && (
      <aside class="preview-banner" role="status">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>
          <strong>Preview Mode:</strong> {article.draft ? 'This article has draft: true and is only visible in preview mode.' : `Scheduled post (releases on ${formatDate(article.publishedDate)}).`}
        </span>
      </aside>
    )}

    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href={homeUrl}>Home</a></li>
          <li aria-hidden="true" class="breadcrumb-sep">&rsaquo;</li>
          <li><a href={categoryUrl}>{article.category}</a></li>
          <li aria-hidden="true" class="breadcrumb-sep">&rsaquo;</li>
          <li aria-current="page" class="breadcrumb-current" title={article.title}>{article.title}</li>
        </ol>
      </nav>

      <div class="article-meta">
        <a href={categoryUrl} class="meta-category">{article.category}</a>
        <span class="meta-sep">&bull;</span>
        <time datetime={article.publishedDate.toISOString()} class="meta-date">
          {formatDate(article.publishedDate)}
        </time>
        {article.modifiedDate && (
          <>
            <span class="meta-sep">&bull;</span>
            <span class="meta-modified">
              Modified <time datetime={article.modifiedDate.toISOString()}>{formatDate(article.modifiedDate)}</time>
            </span>
          </>
        )}
        <span class="meta-sep">&bull;</span>
        <span class="meta-reading-time">{readingTime}</span>
      </div>

      <h1 class="article-title">{article.title}</h1>

      {article.tags.length > 0 && (
        <ul class="article-tags" aria-label="Article tags">
          {article.tags.map((tag) => (
            <li>
              <a href={getPath(`/tags/${slugify(tag)}/`)} class="article-tag-pill">#{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="article-layout">
      <div class="article-main">
        <div class="article-body">
          <Content />
        </div>
      </div>
    </div>

    <footer class="article-footer">
      <!-- Previous / Next Navigation within Category -->
      {(prevArticle || nextArticle) && (
        <nav class="article-pagination" aria-label="Article navigation within category">
          {prevArticle ? (
            <a href={prevArticle.url} class="pagination-link prev" rel="prev">
              <span class="pagination-sub">&larr; Previous</span>
              <span class="pagination-title">{prevArticle.title}</span>
            </a>
          ) : (
            <div class="pagination-empty" />
          )}

          {nextArticle ? (
            <a href={nextArticle.url} class="pagination-link next" rel="next">
              <span class="pagination-sub">Next &rarr;</span>
              <span class="pagination-title">{nextArticle.title}</span>
            </a>
          ) : (
            <div class="pagination-empty" />
          )}
        </nav>
      )}

      <div class="home-return">
        <a href={homeUrl} class="back-home-link">&larr; Back to all articles</a>
      </div>

      <!-- Section 11: Comments (Giscus) -->
      <Comments articleCommentsEnabled={article.comments !== false} />
    </footer>
  </article>

  {hasMermaid && (
    <script>
      function setupMermaid() {
        const blocks = document.querySelectorAll<HTMLElement>('pre.mermaid');
        if (!blocks.length) return;

        // Store original mermaid source for re-rendering on theme toggle
        blocks.forEach((b) => {
          if (!b.dataset.mermaidSrc) {
            b.dataset.mermaidSrc = b.textContent || '';
          }
        });

        let mermaidModulePromise: Promise<typeof import('mermaid')> | null = null;

        async function renderDiagrams() {
          if (!mermaidModulePromise) {
            mermaidModulePromise = import('mermaid');
          }
          const { default: mermaid } = await mermaidModulePromise;
          const isDark = document.documentElement.getAttribute('data-theme') === 'espresso';
          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'neutral',
            fontFamily: 'inherit',
          });
          blocks.forEach((b) => {
            if (b.dataset.mermaidSrc) {
              b.removeAttribute('data-processed');
              b.textContent = b.dataset.mermaidSrc;
            }
          });
          await mermaid.run({ nodes: blocks });
        }

        const io = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            renderDiagrams();
          },
          { rootMargin: '400px' }
        );

        blocks.forEach((b) => io.observe(b));
        window.addEventListener('theme-change', renderDiagrams);
      }

      setupMermaid();
      document.addEventListener('astro:after-swap', setupMermaid);
    </script>
  )}

  <CodeBlockEnhancer />
  <HeadingAnchors />
  <BackToTop />
  <ExternalLinks />
  <ImageLightbox />
</BaseLayout>

<style>
  .article-page {
    width: 100%;
    min-width: 0;
    max-width: 720px;
    padding-top: 1.5rem;
    padding-bottom: 5rem;
    transition: max-width 0.2s ease;
  }

  .preview-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-md);
    background-color: var(--callout-warning-bg);
    border: 1px solid var(--callout-warning-border);
    color: var(--callout-warning-border);
    font-size: 0.9rem;
    font-family: var(--font-body);
  }

  .preview-banner svg {
    flex-shrink: 0;
  }

  .article-layout {
    display: block;
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .article-main {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .article-header {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-muted);
  }

  .breadcrumbs {
    margin-bottom: 0.85rem;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .breadcrumb-list li {
    margin: 0;
  }

  .breadcrumb-list a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb-sep {
    opacity: 0.6;
  }

  .breadcrumb-current {
    color: var(--text);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 32ch;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .meta-category {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .meta-category:hover {
    text-decoration: underline;
  }

  .meta-sep {
    color: var(--border);
    opacity: 0.8;
  }

  .article-title {
    margin: 0;
    font-size: clamp(1.6rem, 6vw, 2.35rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1rem 0 0 0;
    padding: 0;
  }

  .article-tags li {
    margin: 0;
  }

  .article-tag-pill {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .article-tag-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .article-body {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    line-height: var(--line-height-base, 1.75);
    font-size: 1.05rem;
    overflow-wrap: break-word;
  }

  .article-body :global(a) {
    overflow-wrap: anywhere;
  }

  /* Obsidian Wikilinks */
  .article-body :global(.wikilink) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }

  .article-body :global(.wikilink:hover) {
    color: var(--link-hover);
  }

  .article-body :global(.wikilink-broken) {
    color: var(--text-muted);
    border-bottom: 1px dashed var(--border);
    cursor: help;
  }

  /* Obsidian Tags */
  .article-body :global(.tag) {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.1em 0.5em;
    border-radius: 4px;
    margin: 0 0.2em;
    vertical-align: baseline;
  }

  /* Callouts styling & foldable chevrons */
  .article-body :global(.callout) {
    margin: 1.75em 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--border);
    background-color: var(--surface);
    border-radius: 4px;
  }

  .article-body :global(details.callout) {
    padding: 0;
  }

  .article-body :global(details.callout summary.callout-title) {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    user-select: none;
  }

  .article-body :global(details.callout summary.callout-title::-webkit-details-marker) {
    display: none;
  }

  .article-body :global(details.callout .callout-content) {
    padding: 0 1.25rem 1rem 1.25rem;
  }

  .article-body :global(.callout-title) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .article-body :global(.callout-fold-indicator) {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .article-body :global(details.callout[open] .callout-fold-indicator) {
    transform: rotate(180deg);
  }

  /* Callout themes */
  .article-body :global(.callout[data-callout="note"]),
  .article-body :global(.callout[data-callout="info"]) {
    border-left-color: var(--callout-note-border);
    background-color: var(--callout-note-bg);
  }
  .article-body :global(.callout[data-callout="note"] .callout-title),
  .article-body :global(.callout[data-callout="info"] .callout-title) {
    color: var(--callout-note-border);
  }

  .article-body :global(.callout[data-callout="tip"]),
  .article-body :global(.callout[data-callout="hint"]) {
    border-left-color: var(--callout-tip-border);
    background-color: var(--callout-tip-bg);
  }
  .article-body :global(.callout[data-callout="tip"] .callout-title),
  .article-body :global(.callout[data-callout="hint"] .callout-title) {
    color: var(--callout-tip-border);
  }

  .article-body :global(.callout[data-callout="warning"]),
  .article-body :global(.callout[data-callout="caution"]) {
    border-left-color: var(--callout-warning-border);
    background-color: var(--callout-warning-bg);
  }
  .article-body :global(.callout[data-callout="warning"] .callout-title),
  .article-body :global(.callout[data-callout="caution"] .callout-title) {
    color: var(--callout-warning-border);
  }

  .article-body :global(.callout[data-callout="danger"]),
  .article-body :global(.callout[data-callout="error"]) {
    border-left-color: var(--callout-danger-border);
    background-color: var(--callout-danger-bg);
  }
  .article-body :global(.callout[data-callout="danger"] .callout-title),
  .article-body :global(.callout[data-callout="error"] .callout-title) {
    color: var(--callout-danger-border);
  }

  /* Task lists */
  .article-body :global(ul.contains-task-list),
  .article-body :global(ul:has(input[type="checkbox"])) {
    list-style: none;
    padding-left: 0.5rem;
  }

  .article-body :global(li.task-list-item),
  .article-body :global(li:has(input[type="checkbox"])) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .article-body :global(input[type="checkbox"]) {
    accent-color: var(--accent);
    cursor: default;
  }

  /* Footnotes */
  .article-body :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-muted);
    font-size: 0.9em;
    color: var(--text-muted);
  }

  /* Mermaid Diagram */
  .article-body :global(pre.mermaid) {
    background: transparent;
    border: none;
    display: flex;
    justify-content: center;
    padding: 1.5rem 0;
    overflow-x: auto;
    max-width: 100%;
  }

  .article-body :global(pre.mermaid svg) {
    max-width: 100%;
    height: auto;
  }

  /* Article Footer & Pagination */
  .article-footer {
    width: 100%;
    min-width: 0;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-muted);
  }

  .article-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
  }

  .pagination-link:hover {
    border-color: var(--accent);
    background-color: var(--bg);
    transform: translateY(-1px);
  }

  .pagination-link.next {
    text-align: right;
  }

  .pagination-sub {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .pagination-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .pagination-empty {
    visibility: hidden;
  }

  .home-return {
    text-align: center;
    margin-bottom: 2rem;
  }

  .back-home-link {
    color: var(--link);
    text-decoration: none;
    font-weight: 500;
  }

  .back-home-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .article-pagination {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pagination-link.next {
      text-align: left;
    }

    .article-body :global(pre.mermaid) {
      justify-content: flex-start;
    }
  }
</style>
