---
// index.astro - Home Page listing all articles grouped by category per Section 7
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGroupedCategories } from '../lib/articles';
import { generateExcerpt } from '../lib/excerpt';
import { siteConfig, getCanonicalUrl, getPath } from '../../site.config';

const categoryGroups = await getGroupedCategories();
const canonicalUrl = getCanonicalUrl('/');

function formatDate(date: Date): string {
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
  const d = String(date.getUTCDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  canonicalUrl={canonicalUrl}
  ogType="website"
>
  <div class="container home-container">
    <header class="home-header">
      {siteConfig.subtitle && <p class="home-subtitle">{siteConfig.subtitle}</p>}
      <h1 class="home-title">{siteConfig.header}</h1>
      <p class="home-desc">{siteConfig.description}</p>
    </header>

    <div class="categories-list">
      {categoryGroups.map((group) => (
        <section class="category-section" id={`category-${group.slug}`}>
          <div class="category-header">
            <h2 class="category-title">
              <a href={getPath(`/${group.slug}/`)} class="category-hub-link">{group.name}</a>
              <span class="category-count">({group.articles.length})</span>
            </h2>
          </div>

          <ul class="article-list">
            {group.articles.map((article) => {
              const excerpt =
                article.description && article.description.trim() !== ''
                  ? article.description
                  : generateExcerpt(article.rawBody, 140);
              return (
                <li class="article-item">
                  <div class="article-row">
                    <a href={article.url} class="article-link">
                      <span class="article-title">{article.title}</span>
                      {article.draft && <span class="preview-badge draft">Draft</span>}
                      {article.isScheduled && <span class="preview-badge scheduled">Scheduled</span>}
                    </a>
                    <time datetime={article.publishedDate.toISOString()} class="article-date">
                      {formatDate(article.publishedDate)}
                    </time>
                  </div>
                  {excerpt && <p class="article-excerpt">{excerpt}</p>}
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      {categoryGroups.length === 0 && (
        <p class="empty-state">No articles published yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    padding-top: 1rem;
    padding-bottom: 3rem;
  }

  .home-header {
    margin-bottom: 2.75rem;
  }

  .home-subtitle {
    font-family: var(--font-code);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin: 0 0 0.35rem 0;
  }

  .home-title {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: clamp(1.65rem, 6vw, 2.35rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  .home-desc {
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .category-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .category-title {
    margin: 0;
    font-size: 1.35rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .category-hub-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .category-hub-link:hover {
    color: var(--accent);
  }

  .category-count {
    font-family: var(--font-code);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .article-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.35rem 0;
    margin: 0;
  }

  .article-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-link {
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-link:hover {
    color: var(--accent);
  }

  .article-link:hover .article-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-excerpt {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .preview-badge {
    font-family: var(--font-code);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    text-decoration: none;
  }

  .preview-badge.draft {
    background-color: var(--callout-warning-bg);
    color: var(--callout-warning-border);
    border: 1px solid var(--callout-warning-border);
  }

  .preview-badge.scheduled {
    background-color: var(--callout-info-bg, var(--surface));
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .article-date {
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .article-row {
      flex-direction: column;
      gap: 0.2rem;
    }

    .article-date {
      font-size: 0.8rem;
    }
  }
</style>
