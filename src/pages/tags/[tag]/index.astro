---
// src/pages/tags/[tag]/index.astro - Tag Hub Page
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, type TagGroup } from '../../../lib/articles';
import { generateExcerpt } from '../../../lib/excerpt';
import { siteConfig, getCanonicalUrl, getPath } from '../../../../site.config';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }));
}

interface Props {
  group: TagGroup;
}

const { group } = Astro.props;
const canonicalUrl = getCanonicalUrl(`/tags/${group.slug}/`);
const homeUrl = getPath('/');
const description = `Articles tagged with #${group.name} by ${siteConfig.author}.`;
const isThinTag = group.articles.length < 2;
const collectionItems = group.articles.map((a) => ({
  title: a.title,
  url: getCanonicalUrl(`/${a.categorySlug}/${a.slug}/`),
}));

function formatDate(date: Date): string {
  const y = date.getUTCFullYear();
  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
  const d = String(date.getUTCDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
---

<BaseLayout
  title={`#${group.name}`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogType="website"
  schemaType="CollectionPage"
  collectionItems={collectionItems}
  noIndex={isThinTag}
  noFollow={false}
>
  <div class="container hub-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href={homeUrl}>Home</a></li>
        <li aria-hidden="true" class="breadcrumb-sep">&rsaquo;</li>
        <li aria-current="page" class="breadcrumb-current">#{group.name}</li>
      </ol>
    </nav>

    <header class="hub-header">
      <h1 class="hub-title">#{group.name}</h1>
      <p class="hub-desc">
        {group.articles.length} {group.articles.length === 1 ? 'article' : 'articles'} tagged with <code>#{group.name}</code>.
      </p>
    </header>

    <ul class="article-list">
      {group.articles.map((article) => {
        const excerpt =
          article.description && article.description.trim() !== ''
            ? article.description
            : generateExcerpt(article.rawBody, 140);
        return (
          <li class="article-item">
            <div class="article-main-row">
              <a href={article.url} class="article-link">
                <span class="article-title">{article.title}</span>
              </a>
              <time datetime={article.publishedDate.toISOString()} class="article-date">
                {formatDate(article.publishedDate)}
              </time>
            </div>
            {excerpt && <p class="article-excerpt">{excerpt}</p>}
          </li>
        );
      })}
    </ul>

    <div class="hub-footer">
      <a href={homeUrl} class="back-home-link">&larr; Back to all articles</a>
    </div>
  </div>
</BaseLayout>

<style>
  .hub-container {
    padding-top: 1rem;
    padding-bottom: 3rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .breadcrumbs {
    margin-bottom: 0.75rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .breadcrumb-list li {
    margin: 0;
  }

  .breadcrumb-list a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--text);
    font-weight: 500;
  }

  .hub-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-muted);
  }

  .hub-title {
    margin: 0 0 0.5rem 0;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    overflow-wrap: break-word;
  }

  .hub-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-item {
    margin: 0;
    padding-bottom: 1.25rem;
    border-bottom: 1px dashed var(--border-muted);
  }

  .article-main-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .article-link {
    text-decoration: none;
    color: var(--text);
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .article-link:hover .article-title {
    color: var(--accent);
  }

  .article-date {
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .article-excerpt {
    margin: 0.35rem 0 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .hub-footer {
    margin-top: 2.5rem;
  }

  .back-home-link {
    color: var(--link);
    text-decoration: none;
    font-weight: 500;
  }

  .back-home-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .article-main-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    .article-date {
      font-size: 0.8rem;
    }
  }
</style>
